      \uC548\uC804\uBCF4\uB2E4 \uC6B0\uC120\uB418\uB294 \uAC83\uC744 \uBA85\uC2EC\uD558\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 802828291
    m_Localized: "\uCD9C\uADFC\uC744 \uD658\uC601\uD569\uB2C8\uB2E4, \uAD00\uB9AC\uC790
      32\uB2D8. \uC54C\uC218\uC5C6\uB294 \uC6D0\uC778\uC73C\uB85C \uAC1C\uCCB4\uAC00
      \uBD88\uC548\uC815\uD574\uC84C\uC73C\uB2C8 \uC8FC\uC758\uD558\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 802828292
    m_Localized: "\uCD9C\uADFC\uC744 \uD658\uC601\uD569\uB2C8\uB2E4, \uAD00\uB9AC\uC790
      32\uB2D8. \uC790\uC0B0\uC5D0 \uC190\uC2E4\uC774 \uC77C\uC5B4\uB098\uBA74 \uC989\uC2DC
      \uD574\uACE0\uB418\uB2C8 \uC8FC\uC758\uD558\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 802828293
    m_Localized: "\uCD9C\uADFC\uC744 \uD658\uC601\uD569\uB2C8\uB2E4, \uAD00\uB9AC\uC790
      32\uB2D8. \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uC644\uBCBD\uD558\uAC8C \uADFC\uBB34\uD558\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 802828294
    m_Localized: "\uAE30\uBC00 \uB204\uC124 \uAC00\uB2A5\uC131 \uD655\uC778. \uB9D0\uC18C\uB97C
      \uC9C4\uD589\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1243348611072
    m_Localized: "Anomaly Control\nDivision\n<size=60>\uBBF8\uC0C1\uAC1C\uCCB4 \uAD00\uB9AC\uBD80</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 1243373776896
    m_Localized: "<size=42>1. \uC5C5\uBB34 \uBC94\uC704 \uBC0F \uC704\uD5D8\uACE0\uC9C0</size>\r\n\uADC0\uD558\uB294
      \uD1B5\uC81C \uBD88\uAC00\uB2A5\uD55C \uC0DD\uBB3C\uD559\uC801/\uBE44\uD604\uC2E4\uC801
      \uC704\uD5D8\uC5D0 \uB178\uCD9C\uB420 \uC218 \uC788\uC73C\uBA70, \uC5C5\uBB34
      \uC911 \uBC1C\uC0DD\uD558\uB294 \r\n\uC0AC\uB9DD, \uC2E0\uCCB4 \uC808\uB2E8,
      \uC815\uC2E0 \uC624\uC5FC\uC5D0 \uB300\uD574 \uD68C\uC0AC\uB294 \uC77C\uC808
      \uCC45\uC784\uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\r\n\r<size=42>2. \uAE30\uBC00
      \uC720\uC9C0</size>\r\n\uD1F4\uC0AC \uD6C4\uB97C \uD3EC\uD568\uD574 \uAE30\uBC00
      \uB204\uC124\uC774 \uC801\uBC1C\uB420 \uC2DC, \uC989\uAC01\uC801\uC778 \uBC95\uC801
      \uC870\uCE58 \uBC0F \u2018\uAE30\uC5B5 \uC18C\uAC70 \uC2DC\uC220\u2019\uC774
      \uAC15\uC81C \uC9D1\uD589\uB429\uB2C8\uB2E4.\r\n\uC774\uB85C \uC778\uD574 \uBC1C\uC0DD\uD558\uB294
      \uBD80\uC791\uC6A9(\uC9C0\uB2A5 \uC800\uD558 \uB4F1)\uC740 \uD53C\uACE0\uC6A9\uC778\uC758
      \uADC0\uCC45\uC785\uB2C8\uB2E4.\r\n<size=42>3. \uAE34\uAE09 \uC0C1\uD669</size>\r\n\uACA9\uB9AC
      \uC2E4\uD328(Breach) \uB4F1 \uBE44\uC0C1 \uC0C1\uD669 \uBC1C\uC0DD \uC2DC,
      \uC9C1\uC6D0\uC740 \uBCF8\uC778\uC758 \uC548\uC804\uBCF4\uB2E4 \u2018\uC790\uC0B0(\uBCC0\uCE59
      \uAC1C\uCCB4)\u2019\uC758 \n\uD68C\uC218 \uBC0F \uBCF4\uD638\uB97C \uCD5C\uC6B0\uC120\uC73C\uB85C
      \uD574\uC57C \uD569\uB2C8\uB2E4.\r\n\r<size=42>4. \uC0B0\uC5C5\uC7AC\uD574
      \uBC0F \uBCF4\uD5D8</size>\r\n\uBCF8 \uC5C5\uBB34\uB294 \uD2B9\uC218 \uACE0\uC6A9
      \uD615\uD0DC\uC774\uBBC0\uB85C 4\uB300 \uBCF4\uD5D8 \uBC0F \uC0B0\uC7AC \uCC98\uB9AC\uAC00
      \uBD88\uAC00\uD569\uB2C8\uB2E4. \r\n\uC9C1\uBB34 \uC911 \uC0AC\uB9DD \uC2DC,
      \uC2DC\uC2E0\uC740 \uC5F0\uAD6C \uBAA9\uC801\uC73C\uB85C \uD68C\uC0AC\uC5D0
      \uBB34\uC0C1 \uAE30\uC99D\uB429\uB2C8\uB2E4.\n<size=42>5. \uC815\uBCF4 \uAC80\uC5F4</size>\n\uD53C\uACE0\uC6A9\uC778\uC5D0\uAC8C
      \uC81C\uACF5\uB418\uB294 \uC790\uB8CC\uB294 \uD68C\uC0AC\uC758 \uD310\uB2E8\uC5D0
      \uB530\uB77C \uAC80\uC5F4\uB420 \uC218 \uC788\uC73C\uBA70, \n\uD53C\uACE0\uC6A9\uC778\uC774
      \uC800\uC7A5\uD55C \uC815\uBCF4 \uB610\uD55C \uBD88\uC2DC\uC801 \uAC80\uC5F4\uC774
      \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4064357789696
    m_Localized: "\uD574\uC0C1\uB3C4"
    m_Metadata:
      m_Items: []
