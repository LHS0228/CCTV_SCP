  - m_Id: 777662499
    m_Localized: "<line-height=0.08><size=0.045><b>\uAC1C\uCCB4 \uC774\uC0C1\uD604\uC0C1
      \uC5F0\uAD6C \uACB0\uACFC</size></b>\n</line-height>1. <indent=5%>\uAC1C\uCCB4\uAC00
      <b>'\uC18D\uBC15\uB41C \uD68C\uB85C'</b>\uC758 \uBAA8\uC2B5\uC744 \uCDE8\uD588\uC744
      \uB54C <b>\uC804\uAE30\uC801 \uC790\uADF9</b>\uC5D0 \uCDE8\uC57D\uD55C \uBAA8\uC2B5\uC744
      \uD655\uC778\uD588\uB2E4.</indent><line-height=0.08>\n\r</line-height>2. <indent=5%>\uAC1C\uCCB4\uAC00
      <b>\u2018\uCD09\uC218 \uAD70\uC9D1\u2019</b> \uC758 \uBAA8\uC2B5\uC744 \uCDE8\uD588\uC744
      \uB54C <b>\uACE0\uC628\uC758 \uC790\uADF9</b>\uC744 \uC8FC\uC790 \uC6D0 \uD615\uD0DC\uB85C
      \uB3CC\uC544\uC654\uB2E4.</indent><line-height=0.08>\n</line-height>3. <indent=6%>\uAC1C\uCCB4\uAC00
      \uB4A4\uC9D1\uC5B4 \uC4F4  <b>\uC778\uAC04\uD615 \uAECD\uC9C8</b>\uC740 <b>\uACE0\uC628</b>\uC5D0
      \uCDE8\uC57D\uD568\uC744 \n\uD655\uC778\uD588\uB2E4.</indent><line-height=0.08>\r\n</line-height>4.
      <indent=6%>\uC8FC\uAE30\uC801\uC73C\uB85C <b>\uAC00\uBA74\uC744 \uC0DD\uC131</b>\uD558\uC5EC
      \uC2DC\uC124 \uB0B4\uBD80\uC5D0 \uC124\uCE58\uD558\uB294\uB370, \n\uC2DC\uC2A4\uD15C\uC5D0
      \uAC04\uC12D\uD558\uB294 \uB2A5\uB825\uC774 \uC788\uC5B4 \uC2E0\uC18D\uD788
      \uBC1F\uC544 <b>\uD30C\uAD34</b>\uD574\uC57C\uD55C\uB2E4. \uAC00\uBA74\uC5D0\uC11C\uB294
      \uB178\uC774\uC988\uAC19\uC740 \uC18C\uB9AC\uAC00 \uB4E4\uB9BC\uC744 \uD655\uC778\uD588\uB2E4.</indent>\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662500
    m_Localized: "\uAD00\uB9AC\uC79032. \uB2F9\uC2E0\uC758 \uC5C5\uBB34 \uAE30\uAC04\uC774
      \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uCD95\uD558\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777662501
    m_Localized: "End. \uB9D0\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 777662502
    m_Localized: "<line-height=0.08><size=0.045><b>\uAC1C\uCCB4 \uC774\uC0C1\uD604\uC0C1
      \uC5F0\uAD6C \uACB0\uACFC</size></b>\n</line-height>1. <indent=5%>\uAC1C\uCCB4\uAC00
      \uC804\uAE30\uB97C \uBC29\uCD9C\uD574 <b>\uC2A4\uD30C\uD06C</b>\uB97C \uC77C\uC73C\uD0A4\uC790
      \uC8FC\uBCC0 \uC2DC\uC124\uC758 \n\uC2DC\uC2A4\uD15C\uC5D0 \uC774\uC0C1\uC774
      \uBC1C\uC0DD\uD558\uC5EC <b>\uC2DC\uC2A4\uD15C \uC810\uAC80</b>\uC744 \uC2E4\uD589\uD574\uC57C\uD588\uB2E4.</indent><line-height=0.08>\n\r</line-height>2.
      <indent=5%>\uAC1C\uCCB4\uAC00 \uAD6C\uC18D \uC758\uC790\uC5D0\uC11C <b>\uC77C\uC5B4\uB09C</b>
      \uACBD\uC6B0 <b>\uBB3C\uB9AC\uC801 \uCDA9\uACA9</b>\uC73C\uB85C \n\uC9C4\uC555
      \uAC00\uB2A5\uD558\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uD655\uC778\uD588\uB2E4.</indent><line-height=0.08>\n</line-height>3.
      <indent=6%>\uAC1C\uCCB4\uAC00 <b>\uC804\uC120\uC744 \uC0DD\uC131</b>\uD558\uC5EC
      \uC8FC\uBCC0\uC744 \uB36E\uC744 \uACBD\uC6B0\v<b>\uACE0\uC5F4\uB85C \uC18C\uAC01</b>\uD558\uBA74
      \uC0DD\uC131\uC774 \uBA48\uCD94\uB294\uAC83\uC744 \uD655\uC778\uD588\uB2E4.</indent><line-height=0.08>\r\n</line-height>4.
      <indent=6%>\uC885\uC885 \uACE0\uC555 \uC804\uB958\uB97C \uBC1C\uC0DD\uC2DC\uCF1C
      <b>\uC2DC\uC124\uC758 \uC870\uBA85\uC774 \uACE0\uC7A5</b>\uB0AC\uB294\uB370,\n<b>\uCC28\uB2E8\uAE30</b>\uB97C
      \uD1B5\uD574 \uC804\uB825 \uC2DC\uC2A4\uD15C\uC744 \uC7AC\uC124\uC815\uD558\uC5EC
      \uD574\uACB0\uD588\uB2E4.</indent>\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662503
    m_Localized: "\uD558\uC704 \uC9C1\uC6D0\uC758 \uB05D\uC740 \uC5B8\uC81C\uB098
      '\uB9D0\uC18C' \uC785\uB2C8\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662504
    m_Localized: "<b><size=0.05>1. \uBC1C\uC0DD \uAC00\uB2A5\uD55C \uC2E0\uCCB4 \uC774\uC0C1</size></b>\n\uC2DC\uC124
      \uC548\uC758 \uD3D0\uC1C4\uC131\uC73C\uB85C \uC2E0\uCCB4\uC5D0  \uB2E4\uC74C\uACFC
      \uAC19\uC740 \n\uACBD\uBBF8\uD55C \uC774\uC0C1\uC774 \uB098\uD0C0\uB0A0 \uC218
      \uC788\uC2B5\uB2C8\uB2E4.\n<size=0.03>- \uC2DC\uAC01\uC744 \uC800\uD574\uD558\uB294
      \uB178\uC774\uC988\uC640 \uAC19\uC740 \uD658\uAC01\v- \uC790\uC2E0\uC744 \uC81C\uC678\uD55C
      \uB2E4\uB978\uC774\uC758 \uBAA9\uC18C\uB9AC\uC640 \uAC19\uC740 \uD658\uCCAD\v-
      \uC2DC\uC124\uC5D0 \uB4F1\uB85D\uB41C \uAC1C\uCCB4 \uBC0F \uC0AC\uBB3C \uC774\uC678\uC758
      \uBE44\uD604\uC2E4\uC801 \uD658\uAC01</size>\r\n<b><size=0.05>2. \uC2E0\uCCB4
      \uC774\uC0C1 \uB300\uCC98</size></b>\n\uC704\uC640 \uAC19\uC740 \uC774\uC0C1\uC774
      \uC0DD\uAE34\uB2E4\uBA74, \uC989\uC2DC \uB2E4\uC74C \uADF8\uB9BC\uCC98\uB7FC
      \uC0DD\uAE34\n\uCC45\uC0C1 \uC704\uC758 \uAD00\uB9AC\uC790\uC6A9 \uC0C1\uBE44\uC57D\uC744
      \uC0AC\uC6A9\uD558\uC2ED\uC2DC\uC624.\n"
    m_Metadata:
      m_Items: []
