    m_Metadata:
      m_Items: []
  - m_Id: 68784351752195
    m_Localized: "\uBE44\uC0C1. \uBE44\uC0C1. \uB2F9\uC7A5 \uD504\uB85C\uD1A0\uCF5C\uC744
      \uAC00\uB3D9\uD558\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 68784351752196
    m_Localized: "\uC774\uC804 \uAD00\uB9AC \uAE30\uB85D \uB9D0\uC18C, \uC2E0\uC785
      \uAD00\uB9AC\uC790 \uBC88\uD638 \uBC30\uC815. \uCD9C\uADFC\uC744 \uD658\uC601\uD569\uB2C8\uB2E4,
      \uAD00\uB9AC\uC790 33\uB2D8."
    m_Metadata:
      m_Items: []
  - m_Id: 414016800960512
    m_Localized: "\uBC88\uC5ED\uAD00\uB828 \uC548\uB0B4\uC0AC\uD56D"
    m_Metadata:
      m_Items: []
  - m_Id: 414016834514944
    m_Localized: "\uD55C\uAD6D\uC5B4\uB97C \uC81C\uC678\uD55C \uC5B8\uC5B4\uB294
      \uBAA8\uB450 AI\uB97C \uC0AC\uC6A9\uD558\uC5EC \uBC88\uC5ED\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uBC88\uC5ED\uC774 \uC774\uC0C1\uD558\uAC70\uB098 \uC798\uBABB\uB41C \uC810\uC774
      \uC788\uC744 \uC218 \uC788\uC73C\uBBC0\uB85C \uC591\uD574 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
