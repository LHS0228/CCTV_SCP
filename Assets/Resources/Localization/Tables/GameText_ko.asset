  - m_Id: 777662471
    m_Localized: "'\uCD09\uC218 \uAD70\uC9D1' \uAC1C\uCCB4 \uC815\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 777662472
    m_Localized: 'Success

'
    m_Metadata:
      m_Items: []
  - m_Id: 777662473
    m_Localized: "\uC2DC\uC2A4\uD15C \uAC80\uC9C4"
    m_Metadata:
      m_Items: []
  - m_Id: 777662474
    m_Localized: "\uC2DC\uC2A4\uD15C \uAC80\uC9C4\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662475
    m_Localized: "<b><size=0.04>2. \uBBF8\uC0C1\uAC1C\uCCB4 \uAD00\uB9AC \uC720\uC758\uC0AC\uD56D</size></b>\n-
      \uBBF8\uC0C1\uAC1C\uCCB4\uB294 \uC885\uC885 <b>\uC774\uC0C1\uD604\uC0C1</b>\uC744
      \uBC1C\uC0DD\uC2DC\uCF1C \uC2DC\uC124\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4.\n-
      <indent=3%>\uB2F9\uC2E0\uC740 <b>CCTV\uC758 \uAD00\uB9AC \uAE30\uB2A5</b>\uACFC
      <b>\uBCBD\uBA74\uC758 \uAD00\uB9AC \uC2DC\uC124</b>\uC744 \uC0AC\uC6A9\uD558\uC5EC\n<b>\uC774\uC0C1\uD604\uC0C1\uC744
      \uD574\uACB0</b>\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC62C\uBC14\uB978
      \uAD00\uB9AC \uBC29\uBC95\uC740 <b>\uBBF8\uC0C1\uAC1C\uCCB4 \n\uAD00\uB9AC
      \uBB38\uC11C</b>\uC758 \uAC1C\uCCB4 <b>\uC774\uC0C1\uD604\uC0C1 \uC5F0\uAD6C
      \uACB0\uACFC</b>\uB97C \uCC38\uACE0\uD558\uC2ED\uC2DC\uC624</indent>.\n- \uD658\uAC01
      \uB4F1\uC758 \uC2E0\uCCB4 \uC774\uC0C1\uC740 <b>\uC2E0\uCCB4 \uC774\uC0C1 \uBB38\uC11C</b>\uB97C
      \uD655\uC778\uD558\uC2ED\uC2DC\uC624.\r\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662476
    m_Localized: "<line-height=0.1><size=0.055><b>\uAC1C\uCCB4 \uC774\uC0C1\uD604\uC0C1
      \uC5F0\uAD6C \uACB0\uACFC</size></b>\n</line-height>1. <indent=5%>\uAC1C\uCCB4\uAC00
      <b>'\uC18D\uBC15\uB41C \uD68C\uB85C'</b>\uC758 \uBAA8\uC2B5\uC744 \uCDE8\uD588\uC744
      \uB54C <b>\uC804\uAE30\uC801 \uC790\uADF9</b>\uC5D0 \uCDE8\uC57D\uD55C \uBAA8\uC2B5\uC744
      \uD655\uC778\uD588\uB2E4.</indent><line-height=0.08>\n\r</line-height>2. <indent=5%>\uAC1C\uCCB4\uAC00
      <b>\u2018\uCD09\uC218 \uAD70\uC9D1\u2019</b> \uC758 \uBAA8\uC2B5\uC744 \uCDE8\uD588\uC744
      \uB54C <b>\uACE0\uC628\uC758 \uC790\uADF9</b>\uC744 \uC8FC\uC790 \uC6D0 \uD615\uD0DC\uB85C
      \uB3CC\uC544\uC654\uB2E4.</indent><line-height=0.08>\n</line-height>3. <indent=6%>\uAC1C\uCCB4\uAC00
      \uB4A4\uC9D1\uC5B4 \uC4F4  <b>\uC778\uAC04\uD615 \uAECD\uC9C8</b>\uC740 <b>\uACE0\uC628</b>\uC5D0
      \uCDE8\uC57D\uD568\uC744 \n\uD655\uC778\uD588\uB2E4.</indent><line-height=0.08>\r\n</line-height>4.
      <indent=6%>\uC8FC\uAE30\uC801\uC73C\uB85C <b>\uAC00\uBA74\uC744 \uC0DD\uC131</b>\uD558\uC5EC
      \uC2DC\uC124 \uB0B4\uBD80\uC5D0 \uC124\uCE58\uD558\uB294\uB370, \n\uC2DC\uC2A4\uD15C\uC5D0
      \uAC04\uC12D\uD558\uB294 \uB2A5\uB825\uC774 \uC788\uC5B4 \uC2E0\uC18D\uD788
      \uBC1F\uC544 <b>\uD30C\uAD34</b>\uD574\uC57C\uD55C\uB2E4. \uAC00\uBA74\uC5D0\uC11C\uB294
      \uB178\uC774\uC988\uAC19\uC740 \uC18C\uB9AC\uAC00 \uB4E4\uB9BC\uC744 \uD655\uC778\uD588\uB2E4.</indent>\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662477
    m_Localized: "\uC804\uAE30\uCDA9\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 777662478
    m_Localized: "'\uBAA8\uBC29\uC790' \uAC1C\uCCB4 \uC815\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 777662479
    m_Localized: "<line-height=0.1><size=0.055><b>\uAC1C\uCCB4 \uC774\uC0C1\uD604\uC0C1
      \uC5F0\uAD6C \uACB0\uACFC</size></b>\n</line-height>1. <indent=5%>\uAC1C\uCCB4\uAC00
      \uC804\uAE30\uB97C \uBC29\uCD9C\uD574 <b>\uC2A4\uD30C\uD06C</b>\uB97C \uC77C\uC73C\uD0A4\uC790
      \uC8FC\uBCC0 \uC2DC\uC124\uC758 \n\uC2DC\uC2A4\uD15C\uC5D0 \uC774\uC0C1\uC774
      \uBC1C\uC0DD\uD558\uC5EC <b>\uC2DC\uC2A4\uD15C \uC810\uAC80</b>\uC744 \uC2E4\uD589\uD574\uC57C\uD588\uB2E4.</indent><line-height=0.08>\n\r</line-height>2.
      <indent=5%>\uAC1C\uCCB4\uAC00 \uAD6C\uC18D \uC758\uC790\uC5D0\uC11C <b>\uC77C\uC5B4\uB09C</b>
      \uACBD\uC6B0 <b>\uBB3C\uB9AC\uC801 \uCDA9\uACA9</b>\uC73C\uB85C \n\uC9C4\uC555
      \uAC00\uB2A5\uD558\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uD655\uC778\uD588\uB2E4.</indent><line-height=0.08>\n</line-height>3.
      <indent=6%>\uAC1C\uCCB4\uAC00 <b>\uC804\uC120\uC744 \uC0DD\uC131</b>\uD558\uC5EC
      \uC8FC\uBCC0\uC744 \uB36E\uC744 \uACBD\uC6B0\v<b>\uACE0\uC5F4\uB85C \uC18C\uAC01</b>\uD558\uBA74
      \uC0DD\uC131\uC774 \uBA48\uCD94\uB294\uAC83\uC744 \uD655\uC778\uD588\uB2E4.</indent><line-height=0.08>\r\n</line-height>4.
      <indent=6%>\uC885\uC885 \uACE0\uC555 \uC804\uB958\uB97C \uBC1C\uC0DD\uC2DC\uCF1C
      <b>\uC2DC\uC124\uC758 \uC870\uBA85\uC774 \uACE0\uC7A5</b>\uB0AC\uB294\uB370,\n<b>\uCC28\uB2E8\uAE30</b>\uB97C
      \uD1B5\uD574 \uC804\uB825 \uC2DC\uC2A4\uD15C\uC744 \uC7AC\uC124\uC815\uD558\uC5EC
      \uD574\uACB0\uD588\uB2E4.</indent>\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662480
    m_Localized: "<line-height=0.06><b>\uAC1C\uCCB4\uBA85</b>: AC-029 '\uBAA8\uBC29\uC790'\n<b>\uC8FC\uC694
      \uB2A5\uB825</b>: \uC678\uD615 \uBAA8\uBC29, \uC2DC\uC2A4\uD15C \uAC04\uC12D\n</line-height><size=0.035>\u201C\uCCB4\uB974\uB178\uBE4C
      \uB18D\uC7A5\uC5D0\uC11C \uD3EC\uD68D\uB41C \uC0AC\uBB3C\uD615 \uAC1C\uCCB4\r\n\uC778\uAC04\uC744
      \uBAA8\uBC29\uD574 \uC811\uADFC\uD55C \uB4A4\r\n\uAC00\uBA74\uC744 \uC50C\uC6CC
      \uB3D9\uC871\uC73C\uB85C \uB9CC\uB4E0\uB2E4.\u201D\r\n</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 777662481
    m_Localized: "<line-height=0.06><b>\uAC1C\uCCB4\uBA85</b>: AC-017 '\uC18D\uBC15\uB41C
      \uD68C\uB85C'\n<b>\uC8FC\uC694 \uB2A5\uB825</b>: \uC804\uB958 \uC870\uC791,
      \uC804\uC120 \uC0DD\uC131\n</line-height><size=0.035>\u201C\uAD6C\uC18C\uB828
      \uBC99\uCEE4\uC5D0\uC11C \uBC1C\uACAC\uB41C \uC778\uAC04\uD615 \uAC1C\uCCB4.\r\n\uD3C9\uC18C\uC5D4
      \uC804\uB825\uC744 \uD761\uC218\uD558\uB098 \uBD88\uC548\uC815\uD574\uC9C0\uBA74\r\n\uC804\uC120\uC744
      \uC0DD\uC131\uD574 \uC8FC\uBCC0\uC744 \uCD08\uD1A0\uD654\uD55C\uB2E4.\u201D</size>\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662482
    m_Localized: "'\uC18D\uBC15\uB41C \uD68C\uB85C' \uAC1C\uCCB4 \uC815\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 777662483
    m_Localized: "<b><size=0.05>1. \uBC1C\uC0DD \uAC00\uB2A5\uD55C \uC2E0\uCCB4 \uC774\uC0C1</size></b>\n\uC2DC\uC124
      \uC548\uC758 \uD3D0\uC1C4\uC131\uC73C\uB85C \uC2E0\uCCB4\uC5D0  \uB2E4\uC74C\uACFC
      \uAC19\uC740 \n\uACBD\uBBF8\uD55C \uC774\uC0C1\uC774 \uB098\uD0C0\uB0A0 \uC218
      \uC788\uC2B5\uB2C8\uB2E4.\n<size=0.03>- \uC2DC\uAC01\uC744 \uC800\uD574\uD558\uB294
      \uB178\uC774\uC988\uC640 \uAC19\uC740 \uD658\uAC01\v- \uC790\uC2E0\uC744 \uC81C\uC678\uD55C
      \uB2E4\uB978\uC774\uC758 \uBAA9\uC18C\uB9AC\uC640 \uAC19\uC740 \uD658\uCCAD\v-
      \uC2DC\uC124\uC5D0 \uB4F1\uB85D\uB41C \uAC1C\uCCB4 \uBC0F \uC0AC\uBB3C \uC774\uC678\uC758
      \uBE44\uD604\uC2E4\uC801 \uD658\uAC01</size>\n\r\n\n<b><size=0.05>2. \uC2E0\uCCB4
      \uC774\uC0C1 \uB300\uCC98</size></b>\n\uC704\uC640 \uAC19\uC740 \uC774\uC0C1\uC774
      \uC0DD\uAE34\uB2E4\uBA74, \uC989\uC2DC \uB2E4\uC74C \uADF8\uB9BC\uCC98\uB7FC
      \uC0DD\uAE34\n\uCC45\uC0C1 \uC704\uC758 <b>\uAD00\uB9AC\uC790\uC6A9 \uC0C1\uBE44\uC57D</b>\uC744
      \uC0AC\uC6A9\uD558\uC2ED\uC2DC\uC624.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662484
    m_Localized: "\uC804\uAE30\uCDA9\uACA9\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662485
    m_Localized: "\uC2E0\uCCB4 \uC774\uC0C1 \uB300\uCC98 \uB9E4\uB274\uC5BC"
    m_Metadata:
      m_Items: []
  - m_Id: 777662486
    m_Localized: 'Fail

'
    m_Metadata:
      m_Items: []
  - m_Id: 777662487
    m_Localized: "\uAD00\uB9AC\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 777662488
    m_Localized: "\uC624\uB298\uC758 \uD504\uB85C\uD1A0\uCF5C \uCF54\uB4DC - "
    m_Metadata:
      m_Items: []
  - m_Id: 777662489
    m_Localized: "<b><size=0.04>3. \uAE34\uAE09 \uD504\uB85C\uD1A0\uCF5C</size></b>\n-
      \uD2B9\uC815 \uBC29\uC758 <b>\uC548\uC815\uC218\uCE58\uAC00 0</b>\uC774 \uB418\uBA74
      <b>\uAE34\uAE09 \uD504\uB85C\uD1A0\uCF5C</b>\uC774 \uD65C\uC131\uD654\uB429\uB2C8\uB2E4.\n-
      <indent=3%>\uC2DC\uAC04 \uB0B4\uC5D0 <b>\uC5D8\uB808\uBCA0\uC774\uD130 \uC88C\uCE21</b>\uC758
      <b>\uD504\uB85C\uD1A0\uCF5C \uC694\uCCAD\uAE30</b>\uC5D0 <b>\uC62C\uBC14\uB978
      \uCF54\uB4DC</b>\uB97C \uB123\uACE0 \uC2E4\uD589\uD558\uC2ED\uC2DC\uC624. \uCF54\uB4DC\uB294
      <b>\uBCF8 \uBB38\uC11C \uD558\uB2E8</b>\uC5D0 <b>\uB9E4\uC77C \uAC31\uC2E0</b>\uB429\uB2C8\uB2E4.</indent>\n-
      <indent=3%>\uB9CC\uC77C \uC2DC\uAC04 \uB0B4\uC5D0 \uD504\uB85C\uD1A0\uCF5C\uC744
      \uC694\uCCAD\uD558\uC9C0 \uBABB\uD588\uB2E4\uBA74, \uBCF8 \uC2DC\uC124\uC740
      \n\uD3D0\uC1C4\uB418\uBA70 \uC774\uD6C4 \uB9D0\uC18C \uC808\uCC28\uB97C \uBC1F\uC2B5\uB2C8\uB2E4.
      \uD589\uC6B4\uC744 \uBE55\uB2C8\uB2E4.</indent>\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662490
    m_Localized: "<line-height=0.1><size=0.055><b>\uAC1C\uCCB4 \uC774\uC0C1\uD604\uC0C1
      \uC5F0\uAD6C \uACB0\uACFC</size></b>\n\r</line-height>1. <indent=5%>\uAD70\uC9D1\uC758
      \uACF5\uACA9\uC131\uC774 \uC99D\uAC00\uD574  <b>\uC8FC\uBCC0 \uC2DC\uC124\uC744
      \uACF5\uACA9</b> \uD560 \uB54C <b>\uACE0\uC628\uC758 \uC790\uADF9</b>\uC744
      \uAC00\uD558\uBA74 \uACF5\uACA9\uC131\uC774 \uC0AC\uB77C\uC9D0\uC744 \uD655\uC778\uD588\uB2E4.</indent><line-height=0.08>\n</line-height>2.
      <indent=6%>\uACA9\uB9AC\uC2E4 \uB0B4\uBD80\uC758 <b>\uBA39\uC774\uD1B5\uC774
      \uBE44\uC6CC\uC9C0\uC790 </b>\uAE09\uACA9\uD558\uAC8C \uC0C1\uD0DC\uAC00 \n\uBD88\uC548\uC815\uD574\uC9D0\uC744
      \uD655\uC778\uD588\uB2E4. \n\uC774\uD6C4 <b>\uBC30\uC2DD \uC2DC\uC124\uC744
      \uD1B5\uD574 \uBA39\uC774\uB97C \uACF5\uAE09</b>\uD558\uC790\n\uC0C1\uD0DC\uAC00
      \uC548\uC815\uB418\uC5C8\uB2E4. </indent>"
    m_Metadata:
      m_Items: []
  - m_Id: 777662491
    m_Localized: "<b>\uAE30\uBCF8 \uAD00\uB9AC \uADDC\uCE59</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 777662492
    m_Localized: "<b><size=0.04>1. \uC5C5\uBB34 \uBAA9\uD45C</size></b>\n- <indent=3%>\uB2F9\uC2E0\uC758
      \uC5C5\uBB34\uB294 <b>00:00\uC5D0\uC11C 06:00</b>\uAE4C\uC9C0 \uBBF8\uC0C1\uAC1C\uCCB4\uB97C
      \n\uC548\uC815\uC801\uC73C\uB85C \uAD00\uB9AC\uD558\uB294 \uAC83\uC785\uB2C8\uB2E4.</indent>\n-
      <indent=3%>\uBAA8\uB2C8\uD130\uB97C \uD1B5\uD574 \uBBF8\uC0C1\uAC1C\uCCB4\uC758
      <b>\uC548\uC815\uC218\uCE58</b>\uB97C \uD655\uC778\uD558\uACE0 \n<b>0%</b>\uAC00
      \uB418\uAE30 \uC804\uC5D0 \uCC45\uC0C1\uC758 <b>\uD0DC\uBE14\uB9BF</b>\uC744
      \uC0AC\uC6A9\uD574 \uC218\uCE58\uB97C \uC0C1\uC2B9\uC2DC\uD0A4\uC2ED\uC2DC\uC624.</indent>\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662493
    m_Localized: "\uC18C\uAC01\n"
    m_Metadata:
      m_Items: []
  - m_Id: 777662494
    m_Localized: "<line-height=0.06><b>\uAC1C\uCCB4\uBA85</b>: AC-013 '\uCD09\uC218
      \uAD70\uC9D1'\n<b>\uC8FC\uC694 \uB2A5\uB825</b>: \uCD09\uC218 \uACF5\uACA9,
      \uCD09\uC218 \uC0DD\uC131\n</line-height><size=0.035>\u201C\uD310\uD0C0\uB098\uC6B0
      \uB2AA\uC9C0\uB300\uC5D0\uC11C \uBC1C\uACAC\uB41C \uD658\uD615\uB3D9\uBB3C.\r\n\uC12D\uC2DD\uACFC
      \uBC88\uC2DD\uC744 \uB05D\uC5C6\uC774 \uBC18\uBCF5\uD558\uBA70\r\n\uC8FC\uBCC0\uC5D0
      \uBCF4\uC774\uB294 \uBAA8\uB4E0 \uAC83\uC744 \uBA39\uC73C\uB824\uD55C\uB2E4.\u201D\r\n\r\n</size>"
    m_Metadata:
      m_Items: []
