  - m_Id: 777662502
    m_Localized: "<size=135%>\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439</size>\n1.
      \u042D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0440\u0430\u0437\u0440\u044F\u0434\u044B \u0432\u044B\u0437\u044B\u0432\u0430\u043B\u0438
      \u0438\u0441\u043A\u0440\u044B \u0438 \u0441\u0431\u043E\u0438 \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445. \u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0430\u0441\u044C
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u044B.\n2.
      \u041A\u043E\u0433\u0434\u0430 \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044C
      \u0432\u0441\u0442\u0430\u0432\u0430\u043B\u0430 \u0441 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0449\u0435\u0433\u043E
      \u043A\u0440\u0435\u0441\u043B\u0430, \u0435\u0451 \u0443\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044C
      \u043F\u043E\u0434\u0430\u0432\u0438\u0442\u044C \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C.\n3.
      \u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u043B\u0430
      \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u0435\u0431\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u0430,
      \u0441\u0436\u0438\u0433\u0430\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u043E
      \u0438\u0445 \u0440\u043E\u0441\u0442.\n4. \u0420\u0430\u0437\u0440\u044F\u0434\u044B
      \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0432\u044B\u0432\u043E\u0434\u0438\u043B\u0438
      \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F.
      \u0421\u0431\u0440\u043E\u0441 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C \u0443\u0441\u0442\u0440\u0430\u043D\u044F\u043B
      \u0441\u0431\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 777662503
    m_Localized: "\u0414\u043B\u044F \u0440\u044F\u0434\u043E\u0432\u044B\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
