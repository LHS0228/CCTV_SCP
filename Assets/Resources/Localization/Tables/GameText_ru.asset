  - m_Id: 777662494
    m_Localized: "\u0421\u0443\u0449\u043D\u043E\u0441\u0442\u044C: AC-013 \u2014
      \u041A\u043E\u043B\u043E\u043D\u0438\u044F \u0449\u0443\u043F\u0430\u043B\u0435\u0446\n\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438:
      \u0430\u0442\u0430\u043A\u0438 \u0449\u0443\u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438,
      \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u0449\u0443\u043F\u0430\u043B\u0435\u0446\n<size=90%>\u041A\u043E\u043B\u044C\u0447\u0430\u0442\u044B\u0439
      \u0447\u0435\u0440\u0432\u044C, \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0439
      \u0432 \u0431\u043E\u043B\u043E\u0442\u0430\u0445 \u041F\u0430\u043D\u0442\u0430\u043D\u0430\u043B\u0430.
      \u0411\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E \u043F\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0440\u0430\u0437\u043C\u043D\u043E\u0436\u0430\u0435\u0442\u0441\u044F,
      \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u0442\u044C
      \u0432\u0441\u0451, \u0447\u0442\u043E \u0432\u0438\u0434\u0438\u0442.</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 777662495
    m_Localized: "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u044F \u0433\u0430\u043B\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0438\u0439:
