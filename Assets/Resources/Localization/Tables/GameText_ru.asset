  - m_Id: 777662489
    m_Localized: "<size=115%>3. \u0410\u0432\u0430\u0440\u0438\u0439\u043D\u044B\u0439
      \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B</size>\n- \u0415\u0441\u043B\u0438
      \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0432
      \u043B\u044E\u0431\u043E\u0439 \u043A\u0430\u043C\u0435\u0440\u0435 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442
      \u043D\u0443\u043B\u044F, \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0430\u0432\u0430\u0440\u0438\u0439\u043D\u044B\u0439 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B.\n-
      \u0414\u043E \u0438\u0441\u0442\u0435\u0447\u0435\u043D\u0438\u044F \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439
      \u043A\u043E\u0434 \u0432 \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B
      \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0430 \u0441\u043B\u0435\u0432\u0430
      \u043E\u0442 \u043B\u0438\u0444\u0442\u0430 \u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435
      \u0435\u0433\u043E. \u041A\u043E\u0434 \u0432\u043D\u0438\u0437\u0443 \u044D\u0442\u043E\u0433\u043E
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E.\n- \u0415\u0441\u043B\u0438
      \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D \u0432\u043E\u0432\u0440\u0435\u043C\u044F,
      \u043E\u0431\u044A\u0435\u043A\u0442 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u044E\u0442,
      \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
      \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u044F.
      \u0423\u0434\u0430\u0447\u0438."
