  - m_Id: 777662499
    m_Localized: "<size=135%>\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439</size>\n1.
      \u041F\u0440\u0438 \u0438\u043C\u0438\u0442\u0430\u0446\u0438\u0438 \u0421\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u0446\u0435\u043F\u0438 \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044C \u0431\u044B\u043B\u0430
      \u0443\u044F\u0437\u0432\u0438\u043C\u0430 \u043A \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u0440\u0430\u0437\u0440\u044F\u0434\u0430\u043C.\n2. \u041F\u0440\u0438 \u0438\u043C\u0438\u0442\u0430\u0446\u0438\u0438
      \u041A\u043E\u043B\u043E\u043D\u0438\u0438 \u0449\u0443\u043F\u0430\u043B\u0435\u0446
      \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432\u044B\u0441\u043E\u043A\u043E\u0439
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u043E
      \u0435\u0439 \u0438\u0441\u0445\u043E\u0434\u043D\u0443\u044E \u0444\u043E\u0440\u043C\u0443.\n3.
      \u0415\u0451 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043F\u043E\u0434\u043E\u0431\u043D\u0430\u044F
      \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 \u0442\u0430\u043A\u0436\u0435
      \u0431\u044B\u043B\u0430 \u0443\u044F\u0437\u0432\u0438\u043C\u0430 \u043A
      \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0435.\n4.
      \u0421\u0443\u0449\u043D\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438
      \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u043C\u0430\u0441\u043A\u0438 \u043D\u0430
      \u043E\u0431\u044A\u0435\u043A\u0442\u0435. \u041E\u043D\u0438 \u043D\u0430\u0440\u0443\u0448\u0430\u044E\u0442
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0441\u0438\u0441\u0442\u0435\u043C:
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0439\u0442\u0435
      \u0438\u0445, \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u044F \u043D\u0430
      \u043D\u0438\u0445. \u041C\u0430\u0441\u043A\u0438 \u0438\u0437\u0434\u0430\u044E\u0442
      \u0437\u0432\u0443\u043A, \u043F\u043E\u0445\u043E\u0436\u0438\u0439 \u043D\u0430
      \u043F\u043E\u043C\u0435\u0445\u0438."
    m_Metadata:
