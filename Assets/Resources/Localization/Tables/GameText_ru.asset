  - m_Id: 802828288
    m_Localized: "\u041E\u0437\u043D\u0430\u043A\u043E\u043C\u044C\u0442\u0435\u0441\u044C
      \u0441 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C:
      \u0432 \u043D\u0451\u043C \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u0432\u0430\u0436\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u043E \u0440\u0430\u0431\u043E\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 802828289
    m_Localized: "\u041F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0435 \u0437\u0430\u043F\u0438\u0441\u0438
      \u0443\u0434\u0430\u043B\u0435\u043D\u044B. \u041F\u0440\u0438\u0441\u0432\u043E\u0435\u043D
      \u043D\u043E\u0432\u044B\u0439 \u043D\u043E\u043C\u0435\u0440. \u0414\u043E\u0431\u0440\u043E
      \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C, \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440
      32."
    m_Metadata:
      m_Items: []
  - m_Id: 802828290
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C,
      \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440
      32. \u041D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u043C: \u0441\u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0441\u0442\u044C
      \u0430\u043A\u0442\u0438\u0432\u043E\u0432 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
      \u0438\u043C\u0435\u0435\u0442 \u0431\u0435\u0437\u0443\u0441\u043B\u043E\u0432\u043D\u044B\u0439
      \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442 \u043F\u0435\u0440\u0435\u0434
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C\u044E
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 802828291
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C,
      \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440
      32. \u0411\u0443\u0434\u044C\u0442\u0435 \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B:
      \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044C \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u0430
      \u043F\u043E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C
      \u043F\u0440\u0438\u0447\u0438\u043D\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 802828292
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C,
      \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440
      32. \u0423\u0447\u0442\u0438\u0442\u0435: \u043F\u043E\u0442\u0435\u0440\u044F
      \u0430\u043A\u0442\u0438\u0432\u043E\u0432 \u0432\u0435\u0434\u0451\u0442 \u043A
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E\u043C\u0443 \u0443\u0432\u043E\u043B\u044C\u043D\u0435\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 802828293
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C,
      \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440
      32. \u0412\u044B\u043F\u043E\u043B\u043D\u044F\u0439\u0442\u0435 \u0441\u0432\u043E\u0438
      \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E
      \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 802828294
    m_Localized: "\u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C
      \u0443\u0442\u0435\u0447\u043A\u0438 \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0430.
      \u041F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u0435\u043C \u043A \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1243348611072
    m_Localized: "Anomaly Control\nDivision\n<size=60%>\u041E\u0442\u0434\u0435\u043B
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 1243373776896
    m_Localized: "<size=115%>1. \u041E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0440\u0438\u0441\u043A\u0438</size>\n\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C\u0441\u044F \u0441 \u043D\u0435\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u043C\u0438
      \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
      \u0438\u043B\u0438 \u0441\u0432\u0435\u0440\u0445\u044A\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
      \u0443\u0433\u0440\u043E\u0437\u0430\u043C\u0438. \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
      \u043D\u0435 \u043D\u0435\u0441\u0451\u0442 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u0437\u0430 \u0441\u043C\u0435\u0440\u0442\u044C, \u0443\u0432\u0435\u0447\u044C\u044F
      \u0438\u043B\u0438 \u043F\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
      \u0440\u0430\u0431\u043E\u0442\u044B.\n\n<size=115%>2. \u041A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C</size>\n\u0420\u0430\u0437\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
      \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0445 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u0439,
      \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u043F\u043E\u0441\u043B\u0435
      \u0443\u0432\u043E\u043B\u044C\u043D\u0435\u043D\u0438\u044F, \u043F\u043E\u0432\u043B\u0435\u0447\u0451\u0442
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0435 \u043F\u0440\u0430\u0432\u043E\u0432\u044B\u0435
      \u043C\u0435\u0440\u044B \u0438 \u043F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u0441\u0442\u0438\u0440\u0430\u043D\u0438\u0435 \u043F\u0430\u043C\u044F\u0442\u0438.
      \u0417\u0430 \u043F\u043E\u0431\u043E\u0447\u043D\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B,
      \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435
      \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0430, \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
      \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A.\n\n<size=115%>3. \u0427\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u044B\u0435
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438</size>\n\u041F\u0440\u0438
      \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0438 \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043D\u0438\u044F
      \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u043E\u0439 \u0430\u0432\u0430\u0440\u0438\u0438
      \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0435 \u0438 \u0437\u0430\u0449\u0438\u0442\u0430
      \u0430\u043A\u0442\u0438\u0432\u043E\u0432 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
      (\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u0435\u0439)
      \u0438\u043C\u0435\u044E\u0442 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u0448\u0435\u0439 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C\u044E.\n\n<size=115%>4.
      \u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0442\u0440\u0430\u0432\u043C\u044B \u0438 \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0435</size>\n\u041E\u0441\u043E\u0431\u044B\u0439
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u044D\u0442\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B
      \u0438\u0441\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435 \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0435
      \u0438 \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u0442\u0440\u0430\u0432\u043C. \u041F\u0440\u0438 \u0441\u043C\u0435\u0440\u0442\u0438
      \u043D\u0430 \u0441\u043B\u0443\u0436\u0431\u0435 \u0442\u0435\u043B\u043E
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0441\u044F
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0434\u043B\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439.\n\n<size=115%>5.
      \u0426\u0435\u043D\u0437\u0443\u0440\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438</size>\n\u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
      \u0432\u043F\u0440\u0430\u0432\u0435 \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443
      \u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u0438\u044E \u0446\u0435\u043D\u0437\u0443\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B. \u0414\u0430\u043D\u043D\u044B\u0435
      \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432 \u0442\u0430\u043A\u0436\u0435
      \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0442 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u044B\u043C
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430\u043C."
