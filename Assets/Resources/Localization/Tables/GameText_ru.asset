  - m_Id: 777662537
    m_Localized: "\u0418\u043C\u044F \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u0438:
      \u041A\u0438\u043C \u0414\u0436\u0438 \u0412\u043E\u043D\n\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C: \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435\n\n\u041E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0430
      \u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0451\u0439 \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438
      \u0431\u044B\u0432\u0448\u0435\u0433\u043E \u0421\u0421\u0421\u0420."
    m_Metadata:
