  - m_Id: 777662504
    m_Localized: "<size=130%>1. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F</size>\n\u041F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u0435
      \u0432 \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u043E\u043C \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435
      \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u0437\u0432\u0430\u0442\u044C
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u043B\u0451\u0433\u043A\u0438\u0435
      \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u044B:\n- \u0412\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0435
      \u043F\u043E\u043C\u0435\u0445\u0438, \u043C\u0435\u0448\u0430\u044E\u0449\u0438\u0435
      \u043E\u0431\u0437\u043E\u0440\u0443.\n- \u0427\u0443\u0436\u0438\u0435 \u0433\u043E\u043B\u043E\u0441\u0430.\n-
      \u041D\u0435\u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435 \u0432\u0438\u0434\u0435\u043D\u0438\u044F,
      \u043D\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435 \u0441
      \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438
      \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044F\u043C\u0438 \u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C\u0438.\n\n<size=130%>2.
      \u041C\u0435\u0440\u044B \u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F</size>\n\u041F\u0440\u0438
      \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0438 \u044D\u0442\u0438\u0445
      \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u043E\u0432 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u0440\u0438\u043C\u0438\u0442\u0435 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E
      \u0434\u043B\u044F \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u043E\u0432
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435, \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0435
      \u043D\u0438\u0436\u0435."
