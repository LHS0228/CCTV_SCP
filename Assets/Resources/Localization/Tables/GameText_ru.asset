  - m_Id: 777662466
    m_Localized: "\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043C\u044B\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 777662467
    m_Localized: "\u041F\u043E\u043B\u043D\u044B\u0439 \u044D\u043A\u0440\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 777662468
    m_Localized: "\u0412\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u044B\u0439\u0442\u0438 \u0438\u0437
      \u0438\u0433\u0440\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 777662469
    m_Localized: "\u041F\u043E\u0434\u0430\u0432\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 777662470
    m_Localized: "\u0421\u0436\u0435\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 777662471
    m_Localized: "\u0414\u043E\u0441\u044C\u0435: \xAB\u041A\u043E\u043B\u043E\u043D\u0438\u044F
      \u0449\u0443\u043F\u0430\u043B\u0435\u0446\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 777662472
    m_Localized: "\u0423\u0441\u043F\u0435\u0448\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 777662473
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C\n\u0441\u0438\u0441\u0442\u0435\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 777662474
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C\n\u0441\u0438\u0441\u0442\u0435\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 777662475
    m_Localized: "<size=115%>2. \u041C\u0435\u0440\u044B \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u0438
      \u043F\u0440\u0438 \u0440\u0430\u0431\u043E\u0442\u0435 \u0441 \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044F\u043C\u0438</size>\n-
      \u0421\u0443\u0449\u043D\u043E\u0441\u0442\u0438 \u043C\u043E\u0433\u0443\u0442
      \u0432\u044B\u0437\u044B\u0432\u0430\u0442\u044C \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0438,
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0430\u044E\u0449\u0438\u0435 \u043E\u0431\u044A\u0435\u043A\u0442.\n-
      \u0423\u0441\u0442\u0440\u0430\u043D\u044F\u0439\u0442\u0435 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0438
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0441\u0440\u0435\u0434\u0441\u0442\u0432
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F CCTV \u0438 \u043D\u0430\u0441\u0442\u0435\u043D\u043D\u043E\u0433\u043E
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F. \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435
      \u043C\u0435\u0440\u044B \u043E\u043F\u0438\u0441\u0430\u043D\u044B \u0432
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u0445 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439
      \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439 \u0432 \u0434\u043E\u0441\u044C\u0435
      \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u0435\u0439.\n- \u041F\u0440\u0438
      \u0433\u0430\u043B\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0438\u044F\u0445
      \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u0430\u0445
      \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u0435\u0441\u044C \u043A \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0443
      \u043F\u043E \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 777662476
    m_Localized: "<size=135%>\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439</size>\n1.
      \u041F\u0440\u0438 \u0438\u043C\u0438\u0442\u0430\u0446\u0438\u0438 \u0421\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u0446\u0435\u043F\u0438 \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044C \u0431\u044B\u043B\u0430
      \u0443\u044F\u0437\u0432\u0438\u043C\u0430 \u043A \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u0440\u0430\u0437\u0440\u044F\u0434\u0430\u043C.\n2. \u041F\u0440\u0438 \u0438\u043C\u0438\u0442\u0430\u0446\u0438\u0438
      \u041A\u043E\u043B\u043E\u043D\u0438\u0438 \u0449\u0443\u043F\u0430\u043B\u0435\u0446
      \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432\u044B\u0441\u043E\u043A\u043E\u0439
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u043E
      \u0435\u0439 \u0438\u0441\u0445\u043E\u0434\u043D\u0443\u044E \u0444\u043E\u0440\u043C\u0443.\n3.
      \u0415\u0451 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043F\u043E\u0434\u043E\u0431\u043D\u0430\u044F
      \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 \u0442\u0430\u043A\u0436\u0435
      \u0431\u044B\u043B\u0430 \u0443\u044F\u0437\u0432\u0438\u043C\u0430 \u043A
      \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0435.\n4.
      \u0421\u0443\u0449\u043D\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438
      \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u043C\u0430\u0441\u043A\u0438 \u043D\u0430
      \u043E\u0431\u044A\u0435\u043A\u0442\u0435. \u041E\u043D\u0438 \u043D\u0430\u0440\u0443\u0448\u0430\u044E\u0442
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0441\u0438\u0441\u0442\u0435\u043C:
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0439\u0442\u0435
      \u0438\u0445, \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u044F \u043D\u0430
      \u043D\u0438\u0445. \u041C\u0430\u0441\u043A\u0438 \u0438\u0437\u0434\u0430\u044E\u0442
      \u0437\u0432\u0443\u043A, \u043F\u043E\u0445\u043E\u0436\u0438\u0439 \u043D\u0430
      \u043F\u043E\u043C\u0435\u0445\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 777662477
    m_Localized: "\u0423\u0434\u0430\u0440\n\u0442\u043E\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 777662478
    m_Localized: "\u0414\u043E\u0441\u044C\u0435: \xAB\u041C\u0438\u043C\u0438\u043A\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 777662479
    m_Localized: "<size=135%>\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439</size>\n1.
      \u042D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0440\u0430\u0437\u0440\u044F\u0434\u044B \u0432\u044B\u0437\u044B\u0432\u0430\u043B\u0438
      \u0438\u0441\u043A\u0440\u044B \u0438 \u0441\u0431\u043E\u0438 \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445. \u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0430\u0441\u044C
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u044B.\n2.
      \u041A\u043E\u0433\u0434\u0430 \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044C
      \u0432\u0441\u0442\u0430\u0432\u0430\u043B\u0430 \u0441 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0449\u0435\u0433\u043E
      \u043A\u0440\u0435\u0441\u043B\u0430, \u0435\u0451 \u0443\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044C
      \u043F\u043E\u0434\u0430\u0432\u0438\u0442\u044C \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C.\n3.
      \u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u043B\u0430
      \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u0435\u0431\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u0430,
      \u0441\u0436\u0438\u0433\u0430\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u043E
      \u0438\u0445 \u0440\u043E\u0441\u0442.\n4. \u0420\u0430\u0437\u0440\u044F\u0434\u044B
      \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0432\u044B\u0432\u043E\u0434\u0438\u043B\u0438
      \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F.
      \u0421\u0431\u0440\u043E\u0441 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C \u0443\u0441\u0442\u0440\u0430\u043D\u044F\u043B
      \u0441\u0431\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 777662480
    m_Localized: "\u0421\u0443\u0449\u043D\u043E\u0441\u0442\u044C: AC-029 \u2014
      \u041C\u0438\u043C\u0438\u043A\n\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438:
      \u0438\u043C\u0438\u0442\u0430\u0446\u0438\u044F \u043E\u0431\u043B\u0438\u043A\u0430,
      \u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u044B\n<size=90%>\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u043F\u043E\u0434\u043E\u0431\u043D\u0430\u044F
      \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044C, \u043F\u043E\u0439\u043C\u0430\u043D\u043D\u0430\u044F
      \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0432 \u0427\u0435\u0440\u043D\u043E\u0431\u044B\u043B\u0435.
      \u0418\u043C\u0438\u0442\u0438\u0440\u0443\u0435\u0442 \u043B\u044E\u0434\u0435\u0439,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C\u0441\u044F
      \u043A \u0436\u0435\u0440\u0442\u0432\u0435, \u0437\u0430\u0442\u0435\u043C
      \u043D\u0430\u0434\u0435\u0432\u0430\u0435\u0442 \u043D\u0430 \u043D\u0435\u0451
      \u043C\u0430\u0441\u043A\u0443 \u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0432 \u0441\u0435\u0431\u0435 \u043F\u043E\u0434\u043E\u0431\u043D\u0443\u044E.</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 777662481
    m_Localized: "\u0421\u0443\u0449\u043D\u043E\u0441\u0442\u044C: AC-017 \u2014
      \u0421\u043A\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u0446\u0435\u043F\u044C\n\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438:
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0442\u043E\u043A\u043E\u043C,
      \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u043F\u0440\u043E\u0432\u043E\u0434\u043E\u0432\n<size=90%>\u0427\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043F\u043E\u0434\u043E\u0431\u043D\u0430\u044F
      \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044C, \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u0430\u044F
      \u0432 \u0431\u044B\u0432\u0448\u0435\u043C \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u043C
      \u0431\u0443\u043D\u043A\u0435\u0440\u0435. \u041E\u0431\u044B\u0447\u043D\u043E
      \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E,
      \u043D\u043E \u043F\u0440\u0438 \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u043F\u0440\u043E\u0432\u043E\u0434\u0430
      \u0438 \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0430\u0435\u0442 \u0432\u0441\u0451
      \u0432\u043E\u043A\u0440\u0443\u0433.</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 777662482
    m_Localized: "\u0414\u043E\u0441\u044C\u0435: \xAB\u0421\u043A\u043E\u0432\u0430\u043D\u043D\u0430\u044F
      \u0446\u0435\u043F\u044C\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 777662483
    m_Localized: "<size=130%>1. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F</size>\n\u041F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u0435
