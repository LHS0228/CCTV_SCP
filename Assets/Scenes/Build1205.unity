  m_text: "<line-height=0.08><size=0.045><b>\uAC1C\uCCB4 \uC774\uC0C1\uD604\uC0C1
    \uC5F0\uAD6C \uACB0\uACFC</size></b>\n</line-height>1. <indent=5%>\uC774\uC0C1
    \uBC88\uC2DD\uC73C\uB85C <b>\uCD09\uC218\uAC00 \uC99D\uAC00</b>\uD560 \uB54C
    <b>\uACE0\uC628\uC758 \uC790\uADF9</b>\uC744 \uAC00\uD558\uBA74 \uBC88\uC2DD\uC774
    \uC885\uB8CC\uB428\uC744 \uD655\uC778\uD588\uB2E4.</indent><line-height=0.08>\n\r</line-height>2.
    <indent=5%>\uAD70\uC9D1\uC758 \uACF5\uACA9\uC131\uC774 \uC99D\uAC00\uD574  <b>\uC8FC\uBCC0
    \uC2DC\uC124\uC744 \uACF5\uACA9</b> \uD560 \uB54C <b>\uBB3C\uB9AC\uC801 \uCDA9\uACA9</b>\uC73C\uB85C
    \uC9C4\uC555\uC774 \uAC00\uB2A5\uD568\uC744 \uD655\uC778\uD588\uB2E4.</indent><line-height=0.08>\n</line-height>3.
    <indent=6%>\uACA9\uB9AC\uC2E4 \uB0B4\uBD80\uC758 <b>\uBA39\uC774\uD1B5\uC774
    \uBE44\uC6CC\uC9C0\uC790 </b>\uAE09\uACA9\uD558\uAC8C \uC0C1\uD0DC\uAC00 \n\uBD88\uC548\uC815\uD574\uC9D0\uC744
    \uD655\uC778\uD588\uB2E4. \n\uC774\uD6C4 <b>\uBC30\uC2DD \uC2DC\uC124\uC744 \uD1B5\uD574
    \uBA39\uC774\uB97C \uACF5\uAE09</b>\uD558\uC790\n\uC0C1\uD0DC\uAC00 \uC548\uC815\uB418\uC5C8\uB2E4.
    </indent>"
